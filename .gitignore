# Локальные исходники для генерации oge15 (скриншоты, превью, служебные скрипты)
# На проде не нужны — там только готовые populate_oge15_*.py из users/management/.
oge1_5_setup/

# То же для второй части ОГЭ: скрейпы банка, карточки задач и проверяльщики.
# На проде нужны только сами генераторы (users/oge2N_generators.py, users/generators/)
# и сид-команды.
oge20_setup/
oge21_setup/
oge22_setup/
oge23_setup/
oge24_setup/
oge25_setup/

# Виртуальная химлаборатория — летняя игрушка, от сайта отцеплена 5 сентября 2026.
# Лежит на рабочей машине, в репозиторий не едет: без неё сайт работает,
# а с ней в INSTALLED_APPS и без папки — падает целиком.
chemlab/

# fpi cache (если когда-то скачивали)
fipi_cache/

# Дамп для деплоя (локально создаётся командой dumpdata_for_deploy)
deploy_data.json
*.dump.json

# Черновики подбора весов — локальные, в репозиторий не едут. Место найденных
# чисел — в bot.ВЕСА, после проверки матчем на сильном уровне; сами файлы
# нужны только между запуском и проверкой.
games/tuned_weights.log
games/tuned_weights.json
games/learned*.json

# Данные самоигры для обучения оценки: сотни мегабайт, пересоздаются командой
# `manage.py selfplay` за минуты. Держать их в истории незачем, а вот сломать
# ими клонирование — очень легко.
games/selfplay_*.txt
games/selfplay_data*.csv
