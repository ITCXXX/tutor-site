# ============================================================================
# nginx-конфиг для tutor_site.
# Положить в /etc/nginx/sites-available/tutor, затем:
#   ln -s /etc/nginx/sites-available/tutor /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# Этот файл — ВРЕМЕННЫЙ конфиг (только http) для первого certbot.
# После certbot --nginx он сам допишет блок https + редирект.
# ============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name zenchenkoim.ru www.zenchenkoim.ru;

    # Размер загружаемых файлов (на случай больших PDF/картинок).
    # Должен быть ЧУТЬ БОЛЬШЕ лимита в board/views.py (_UPLOAD_MAX = 30 МБ):
    # тогда файл доходит до Django и пользователь видит понятное «Файл больше
    # 30 МБ», а не молчаливый обрыв соединения на nginx. Запас — на служебную
    # обвязку multipart-запроса.
    client_max_body_size 32M;

    # ACME challenge для Let's Encrypt — ДОЛЖЕН отдаваться по http.
    # Стоит ВЫШЕ канонического редиректа: certbot обязан достучаться по любому
    # из имён, иначе выпуск сертификата на www сорвётся.
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    # Канонический адрес — без www.
    # Django привязывает куку сессии к точному имени хоста (SESSION_COOKIE_DOMAIN
    # не задан), поэтому вход на www.zenchenkoim.ru НЕ действует на
    # zenchenkoim.ru и наоборот: человека снова встречает страница входа. Ссылку
    # на доску кнопка «копировать» берёт из адресной строки как есть, так что
    # преподаватель с www легко раздаёт ученикам «другой» сайт.
    # $scheme, а не https: до certbot сайт работает по http, и жёсткий https
    # здесь увёл бы на ещё не существующий адрес.
    if ($host ~* ^www\.(.+)$) {
        return 301 $scheme://$1$request_uri;
    }

    # ── Загруженные файлы ────────────────────────────────────────────────
    # Обложки, картинки заданий и файлы досок отдаём напрямую, минуя Django.
    # Сданные работы и методические материалы — только после проверки прав.

    # Служебная проверка прав: сюда nginx ходит сам, снаружи она не нужна.
    location = /media-guard/ {
        internal;
        proxy_pass http://unix:/run/tutor/tutor.sock;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        # Какой файл спрашивают — Django берёт адрес отсюда.
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Сданные работы учеников и методические материалы — только по праву.
    # Сначала спрашиваем Django, потом отдаём файл сами: проверка стоит один
    # лёгкий запрос, а раздачу по-прежнему делает nginx.
    location ~ ^/media/(hw/submissions|materials/files)/ {
        auth_request /media-guard/;
        root /opt/tutor;
        # Приватное не кэшируем у посредников: иначе прокси отдаст файл
        # следующему, уже не спрашивая разрешения.
        expires -1;
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        # Отказ показываем понятной строкой. error_page держим ВНУТРИ блока:
        # на уровне сервера он перехватывал бы и отказы самого Django.
        error_page 401 403 = @media_denied;
    }
    location @media_denied {
        default_type text/plain; charset utf-8;
        return 403 "Нет доступа к этому файлу";
    }

    location /media/ {
        alias /opt/tutor/media/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        # Тот же заголовок, что Django ставит на всё остальное: браузер не
        # должен угадывать тип файла по содержимому.
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # Статика (Django collectstatic) — отдаёт WhiteNoise через gunicorn,
    # но nginx тоже может, если хочется снять нагрузку с Python:
    # location /static/ {
    #     alias /opt/tutor/staticfiles/;
    #     expires 30d;
    #     add_header Cache-Control "public, immutable";
    # }

    # WebSocket совместной доски (раздел board) → daphne (ASGI) на 127.0.0.1:8001.
    # ДОЛЖЕН идти ДО "location /", иначе WS попадёт на gunicorn (WSGI) и не поднимется.
    location /ws/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;   # долгие idle WS-соединения не рвём
        proxy_send_timeout 3600s;
    }

    # Всё остальное — на gunicorn (через unix-сокет).
    location / {
        proxy_pass http://unix:/run/tutor/tutor.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_read_timeout 60s;
    }

    # Прячем версию nginx.
    server_tokens off;
}
