# Когда делать резервную копию tutor_site.
# Ставится вместе с tutor-backup.service — см. комментарий в нём.

[Unit]
Description=Ежедневная резервная копия tutor_site

[Timer]
# Ночью, когда занятий заведомо нет.
OnCalendar=*-*-* 04:30:00
# Разброс в четверть часа: если сервер делит железо с соседями, не упираемся
# в общий пик нагрузки ровно в 04:30.
RandomizedDelaySec=15m
# Сервер мог быть выключен в это время — сделать копию сразу после включения.
Persistent=true

[Install]
WantedBy=timers.target
