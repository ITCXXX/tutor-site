# ============================================================================
# coturn — сервер-ретранслятор для голосовой связи на доске.
#
# Зачем он нужен. Обычно браузеры соединяются напрямую, и звук идёт мимо
# сервера — это быстро и бесплатно. Но примерно у каждого пятого участника
# домашний роутер или мобильный оператор прямое соединение не пропускают.
# Для таких coturn перекидывает звук через себя. Для остальных он не
# задействуется вообще, так что задержка у большинства не вырастет.
#
# Положить в /etc/turnserver.conf, затем:
#   systemctl enable --now coturn
#
# ВАЖНО: значения в угловых скобках заменить на свои.
# ============================================================================

# --- Кто мы -----------------------------------------------------------------
realm=zenchenkoim.ru
server-name=zenchenkoim.ru

# Внешний (белый) адрес сервера. Если VPS сам за NAT, пишется так:
#   external-ip=<БЕЛЫЙ_IP>/<ВНУТРЕННИЙ_IP>
external-ip=<IP_ВАШЕГО_VPS>

# --- Порты ------------------------------------------------------------------
listening-port=3478
tls-listening-port=5349

# Диапазон портов, через которые пойдёт звук. Должен быть открыт в фаерволе.
# 40 портов хватит с большим запасом: одно занятие — это 1–2 соединения.
min-port=49160
max-port=49200

# --- Пропуска ---------------------------------------------------------------
# Постоянных логинов и паролей здесь НЕТ, и это принципиально: пароль, вшитый
# в страницу сайта, любой желающий вытащил бы за минуту и гонял бы через ваш
# сервер свой трафик. Вместо этого сайт выдаёт участнику временный пропуск,
# подписанный общим секретом, а coturn проверяет подпись тем же секретом.
#
# Значение ДОЛЖНО совпадать с TURN_SECRET в файле .env вашего сайта.
# Сгенерировать:  openssl rand -hex 32
use-auth-secret
static-auth-secret=<ТОТ_ЖЕ_СЕКРЕТ_ЧТО_В_ENV>

# --- Шифрование -------------------------------------------------------------
# Берём тот же сертификат, что у сайта. Учтите: coturn работает под своим
# пользователем и по умолчанию не имеет права читать файлы Let's Encrypt —
# как выдать доступ, написано в DEPLOY.md.
cert=/etc/letsencrypt/live/zenchenkoim.ru/fullchain.pem
pkey=/etc/letsencrypt/live/zenchenkoim.ru/privkey.pem
no-tlsv1
no-tlsv1_1

# --- Безопасность -----------------------------------------------------------
# Самое важное в этом файле. Ретранслятор по своей природе умеет соединяться
# с любым адресом по просьбе клиента. Без запретов ниже посторонний мог бы
# через него достучаться до вашей же базы данных и других служб, которые
# доступны только «изнутри» сервера. Закрываем внутренние сети целиком.
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# Служебная консоль управления не нужна — отключаем, чтобы не торчала наружу.
no-cli
fingerprint
stale-nonce=600

# --- Бережём одноядерный сервер ---------------------------------------------
# Ограничения на всякий случай: если пропуск всё же утечёт, чужой трафик
# упрётся в потолок, а не съест весь канал.
total-quota=50
user-quota=6
# Килобит в секунду на всех. Голос — это ~40 кбит/с на поток, так что 2 Мбит/с
# с запасом покрывают занятие; поднимите, если появятся групповые.
bps-capacity=2000

# --- Журнал -----------------------------------------------------------------
log-file=/var/log/turnserver.log
simple-log
