# Когда напоминать о сроках ДЗ.
# Ставится вместе с tutor-remind.service — см. комментарий в нём.

[Unit]
Description=Ежедневные напоминания о сроках ДЗ (tutor_site)

[Timer]
# Утром: ученик увидит напоминание в начале дня, а не ночью, когда спит.
OnCalendar=*-*-* 07:00:00
RandomizedDelaySec=10m
# Сервер мог быть выключен в это время — напомнить сразу после включения.
# Повторных уведомлений это не создаст: каждое событие уходит ровно один раз
# (ключ повторности у Notification).
Persistent=true

[Install]
WantedBy=timers.target
